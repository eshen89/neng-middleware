# neng-middleware auth configuration (consumed by neng-agent + neng-user via their own env).
#
# Leave SUPABASE_JWKS_URL unset (or NENG_AUTH_DISABLED=1) to run OFFLINE: verification is
# skipped and every request resolves to the fixed `dev-user`. That is how pytest + the chat
# eval run with no network. NENG_ENV=prod refuses to boot in that state (assert_safe_boot).

# Supabase project JWKS endpoint (asymmetric public keys).
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Expected token issuer + audience. Supabase: iss=<project>/auth/v1, aud=authenticated.
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Accepted signing algorithms (Supabase asymmetric keys). Comma-separated.
NENG_AUTH_ALGORITHMS=ES256,RS256

# Deployment environment. prod makes the auth bypass a fatal boot error.
NENG_ENV=dev
# Master offline switch (dev/tests/eval). Truthy → skip verification, inject dev-user.
# NENG_AUTH_DISABLED=1

# Internal S2S calls (SigV4). Truthy → skip signing and call a local stub (offline).
# NENG_INTERNAL_BYPASS=1
